# Stage builder
FROM node:20 AS builder
WORKDIR /app/dsilva-store

# Copiar arquivos essenciais primeiro para aproveitar cache
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn .yarn
COPY . .

# Garantir corepack e ativar a versão do yarn usada pelo projeto
RUN corepack enable \
    && corepack prepare yarn@4.12.0 --activate

# Limpar node_modules caso exista no contexto
RUN rm -rf node_modules

# Instalar dependências e build
RUN apt-get update && apt-get install -y python3 python3-pip python-is-python3
RUN yarn install --immutable --immutable-cache --check-cache
RUN yarn build

# Stage runtime
FROM node:20 AS runtime
WORKDIR /app/dsilva-store

# Variáveis de build (não coloque segredos aqui)
ARG COOKIE_SECRET
ARG JWT_SECRET
ARG STORE_CORS
ARG ADMIN_CORS
ARG AUTH_CORS
ARG DISABLE_ADMIN
ARG WORKER_MODE
ARG PORT
ARG DATABASE_URL
ARG REDIS_URL
ARG BACKEND_URL

# Expor porta padrão (ajuste se necessário)
ENV PORT=${PORT:-9000}
EXPOSE ${PORT}

# Instalar runtime dependencies se necessário
RUN apt-get update && apt-get install -y python3 python3-pip python-is-python3

# Copiar artefatos do builder
COPY --from=builder /app/dsilva-store ./

# Se o seu projeto gerar uma pasta .medusa ou dist, garanta que o CMD inicie corretamente
# Ajuste o comando abaixo conforme seu package.json (start, start:prod, medusa, etc.)
CMD ["yarn", "run", "start"]
